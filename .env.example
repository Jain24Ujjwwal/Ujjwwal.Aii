# ==========================================
# Ujjwwal AI - Global Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Secrets
JWT_SECRET=super_secure_jwt_secret_change_in_production_min_32_chars_123456
JWT_REFRESH_SECRET=super_secure_refresh_secret_change_in_production_min_32_chars_789
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Database Configuration (PostgreSQL / Supabase)
# Leave empty for local development to use automatic high-performance in-memory fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ujjwwal_ai_db

# AI Provider API Keys (NEVER expose to frontend!)
# Get your Google Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Secondary AI providers (for future expansion)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Storage & Uploads
UPLOAD_MAX_FILE_SIZE_MB=25
MAX_CHAT_HISTORY_TOKENS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
